{
  "name": "near-field",
  "version": "0.1.0",
  "description": "Cursor proximity as a CSS input. One tiny import exposes how close the pointer is to an element as custom properties, plus three pre-tuned effects built on that primitive.",
  "keywords": [
    "proximity",
    "cursor",
    "pointer",
    "magnetic",
    "tilt",
    "glow",
    "hover",
    "css-variables",
    "react",
    "spring"
  ],
  "license": "MIT",
  "author": "Thilina Rathnayaka (https://thilina.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edward-126/near-field.git"
  },
  "homepage": "https://github.com/edward-126/near-field#readme",
  "bugs": "https://github.com/edward-126/near-field/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
